#
# UVD (video decode) microcode. Shared by all Southern Islands chips
# (Tahiti, Pitcairn, Verde, Oland, Aruba); there is no oland_uvd.bin.
#
TAHITI_uvd_fw.c		optional radeonkmsfw_oland | radeonkmsfw	\
	compile-with	"${AWK} -f $S/tools/fw_stub.awk TAHITI_uvd.fw:radeon/TAHITI_uvd.bin -mradeon_TAHITI_uvd_bin -c${.TARGET}" \
	no-ctfconvert no-implicit-rule before-depend local		\
	clean		"TAHITI_uvd_fw.c"
TAHITI_uvd_fw.fwo	optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"TAHITI_uvd.fw"					\
	compile-with	"${NORMAL_FWO}"					\
	no-implicit-rule						\
	clean		"TAHITI_uvd_fw.fwo"
TAHITI_uvd.fw		optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"$S/contrib/dev/radeonkmsfw/TAHITI_uvd.bin"	\
	compile-with	"${CP} ${.ALLSRC} ${.TARGET}"			\
	no-obj no-implicit-rule						\
	clean		"TAHITI_uvd.fw"
