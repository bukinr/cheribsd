oland_smc_fw.c		optional radeonkmsfw_oland | radeonkmsfw	\
	compile-with	"${AWK} -f $S/tools/fw_stub.awk oland_smc.fw:radeon/oland_smc.bin -mradeon_oland_smc_bin -c${.TARGET}" \
