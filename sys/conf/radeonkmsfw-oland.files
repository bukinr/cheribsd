#
# Radeon Oland (Southern Islands) microcode, compiled into the kernel.
# Append to sys/conf/files.
#
# Expects the raw blobs in:  sys/contrib/dev/radeonkmsfw/oland_*.bin
# Kernel config:             device radeonkmsfw_oland   (or: device radeonkmsfw)
#
# Image names are registered as "radeon/oland_*.bin", i.e. exactly what the
# drm-kmod radeon driver passes to request_firmware(), so linuxkpi finds them
# on its first lookup.
#
oland_ce_fw.c		optional radeonkmsfw_oland | radeonkmsfw	\
	compile-with	"${AWK} -f $S/tools/fw_stub.awk oland_ce.fw:radeon/oland_ce.bin -mradeon_oland_ce_bin -c${.TARGET}" \
	no-ctfconvert no-implicit-rule before-depend local		\
	clean		"oland_ce_fw.c"
oland_ce_fw.fwo		optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"oland_ce.fw"					\
	compile-with	"${NORMAL_FWO}"					\
	no-implicit-rule						\
	clean		"oland_ce_fw.fwo"
oland_ce.fw		optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"$S/contrib/dev/radeonkmsfw/oland_ce.bin"	\
	compile-with	"${CP} ${.ALLSRC} ${.TARGET}"			\
	no-obj no-implicit-rule						\
	clean		"oland_ce.fw"
oland_k_smc_fw.c	optional radeonkmsfw_oland | radeonkmsfw	\
	compile-with	"${AWK} -f $S/tools/fw_stub.awk oland_k_smc.fw:radeon/oland_k_smc.bin -mradeon_oland_k_smc_bin -c${.TARGET}" \
	no-ctfconvert no-implicit-rule before-depend local		\
	clean		"oland_k_smc_fw.c"
oland_k_smc_fw.fwo	optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"oland_k_smc.fw"				\
	compile-with	"${NORMAL_FWO}"					\
	no-implicit-rule						\
	clean		"oland_k_smc_fw.fwo"
oland_k_smc.fw		optional radeonkmsfw_oland | radeonkmsfw	\
	dependency	"$S/contrib/dev/radeonkmsfw/oland_k_smc.bin"	\
	compile-with	"${CP} ${.ALLSRC} ${.TARGET}"			\
	no-obj no-implicit-rule						\
	clean		"oland_k_smc.fw"
oland_mc_fw.c		optional radeonkmsfw_oland | radeonkmsfw	\
	compile-with	"${AWK} -f $S/tools/fw_stub.awk oland_mc.fw:radeon/oland_mc.bin -mradeon_oland_mc_bin -c${.TARGET}" \
